(mod (
    USER_PUBLIC_KEY HUB_PUBLIC_KEY USER_PUZZLE_HASH GENESIS_CHALLENGE AGG_SIG_ME_ADDITIONAL_DATA
    FUNDING_AMOUNT CLAIM_BEFORE_HEIGHT REFUND_HEIGHT
    branch funding_coin_id merchant_puzzle_hash settlement_amount user_remainder settlement_nonce
  )
  (include *standard-cl-23*)

  (defconstant CLAIM 1)
  (defconstant REFUND 2)
  (defconstant AGG_SIG_ME 50)
  (defconstant CREATE_COIN 51)
  (defconstant ASSERT_MY_COIN_ID 70)
  (defconstant ASSERT_MY_AMOUNT 73)
  (defconstant ASSERT_HEIGHT_ABSOLUTE 83)
  (defconstant ASSERT_BEFORE_HEIGHT_ABSOLUTE 87)
  (defconstant PROTOCOL_VERSION 0x0002)
  (defconstant FEE_POLICY 0x00)
  (defconstant CHANNEL_DOMAIN "WALL_HUB_CHANNEL_V2")
  (defconstant TERMS_DOMAIN "WALL_HUB_TERMS_V2")
  (defconstant SETTLEMENT_DOMAIN "WALL_HUB_SETTLEMENT_V2")
  (defconstant REFUND_DOMAIN "WALL_HUB_REFUND_V2")

  (defun-inline require (condition value) (if condition value (x)))
  (defun-inline channel-id (coin-id)
    (sha256 CHANNEL_DOMAIN GENESIS_CHALLENGE coin-id)
  )
  (defun-inline terms-hash ()
    (sha256 TERMS_DOMAIN PROTOCOL_VERSION GENESIS_CHALLENGE AGG_SIG_ME_ADDITIONAL_DATA
      HUB_PUBLIC_KEY USER_PUBLIC_KEY USER_PUZZLE_HASH FUNDING_AMOUNT
      CLAIM_BEFORE_HEIGHT REFUND_HEIGHT)
  )
  (defun-inline settlement-hash (coin-id merchant-ph merchant-amount remainder nonce)
    (sha256 SETTLEMENT_DOMAIN PROTOCOL_VERSION GENESIS_CHALLENGE coin-id
      (channel-id coin-id) (terms-hash) merchant-ph merchant-amount USER_PUZZLE_HASH
      remainder nonce CLAIM_BEFORE_HEIGHT REFUND_HEIGHT FEE_POLICY)
  )
  (defun-inline refund-hash (coin-id)
    (sha256 REFUND_DOMAIN PROTOCOL_VERSION GENESIS_CHALLENGE coin-id
      (channel-id coin-id) (terms-hash) USER_PUZZLE_HASH FUNDING_AMOUNT REFUND_HEIGHT FEE_POLICY)
  )

  (require (= (strlen USER_PUBLIC_KEY) 48)
    (require (= (strlen HUB_PUBLIC_KEY) 48)
      (require (= (strlen USER_PUZZLE_HASH) 32)
        (require (= (strlen GENESIS_CHALLENGE) 32)
          (require (= (strlen AGG_SIG_ME_ADDITIONAL_DATA) 32)
            (require (= (strlen FUNDING_AMOUNT) 8)
            (require (= (strlen CLAIM_BEFORE_HEIGHT) 8)
              (require (= (strlen REFUND_HEIGHT) 8)
                (require (> REFUND_HEIGHT CLAIM_BEFORE_HEIGHT)
                  (require (= (strlen funding_coin_id) 32)
                    (if (= branch CLAIM)
                      (require (= (strlen merchant_puzzle_hash) 32)
                        (require (= (strlen settlement_amount) 8)
                          (require (= (strlen user_remainder) 8)
                            (require (= (strlen settlement_nonce) 32)
                              (require (> settlement_amount 0)
                                (require (> user_remainder 0)
                                  (require (= (+ settlement_amount user_remainder) (+ FUNDING_AMOUNT 0))
                                    (list
                                      (list ASSERT_MY_COIN_ID funding_coin_id)
                                      (list ASSERT_MY_AMOUNT (+ FUNDING_AMOUNT 0))
                                      (list ASSERT_BEFORE_HEIGHT_ABSOLUTE (+ CLAIM_BEFORE_HEIGHT 0))
                                      (list AGG_SIG_ME USER_PUBLIC_KEY
                                        (settlement-hash funding_coin_id merchant_puzzle_hash settlement_amount user_remainder settlement_nonce))
                                      (list AGG_SIG_ME HUB_PUBLIC_KEY
                                        (settlement-hash funding_coin_id merchant_puzzle_hash settlement_amount user_remainder settlement_nonce))
                                      (list CREATE_COIN merchant_puzzle_hash (+ settlement_amount 0))
                                      (list CREATE_COIN USER_PUZZLE_HASH (+ user_remainder 0))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                      (require (= branch REFUND)
                        (list
                          (list ASSERT_MY_COIN_ID funding_coin_id)
                          (list ASSERT_MY_AMOUNT (+ FUNDING_AMOUNT 0))
                          (list ASSERT_HEIGHT_ABSOLUTE (+ REFUND_HEIGHT 0))
                          (list AGG_SIG_ME USER_PUBLIC_KEY (refund-hash funding_coin_id))
                          (list CREATE_COIN USER_PUZZLE_HASH (+ FUNDING_AMOUNT 0))
                        )
                      )
                    )
                  )
                )
              )
            )
            )
          )
        )
      )
    )
  )
)
